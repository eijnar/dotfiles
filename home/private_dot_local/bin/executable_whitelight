#!/usr/bin/env python3
"""Fill every monitor with pure white, e.g. as a fill light for video calls.

Quit with Esc, q, or any mouse click.
"""
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gtk

CSS = b"window { background-color: #ffffff; }"


class WhiteLight(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="se.kaffesump.WhiteLight")
        self.windows = []

    def do_activate(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        screen = Gdk.Screen.get_default()
        Gtk.StyleContext.add_provider_for_screen(
            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        display = Gdk.Display.get_default()
        for i in range(display.get_n_monitors()):
            win = Gtk.ApplicationWindow(application=self)
            win.set_decorated(False)
            win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
            win.connect("key-press-event", self.on_key)
            win.connect("button-press-event", lambda *_: self.quit())
            win.connect("realize", self.hide_cursor)
            win.show_all()
            win.fullscreen_on_monitor(screen, i)
            self.windows.append(win)

        # Keep the screen from dimming or locking while the light is on.
        self.inhibit(
            self.windows[0],
            Gtk.ApplicationInhibitFlags.IDLE,
            "White fill light active",
        )

    def hide_cursor(self, win):
        gdk_win = win.get_window()
        gdk_win.set_cursor(Gdk.Cursor.new_from_name(gdk_win.get_display(), "none"))

    def on_key(self, _win, event):
        if event.keyval in (Gdk.KEY_Escape, Gdk.KEY_q, Gdk.KEY_Q):
            self.quit()


if __name__ == "__main__":
    WhiteLight().run()
