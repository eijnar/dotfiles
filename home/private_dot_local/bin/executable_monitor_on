#!/usr/bin/env bash
set -euo pipefail

gdctl set \
  --logical-monitor --x 2933 --y 0    --scale 1.0 --transform normal --monitor HDMI-2 --mode 1920x1080@60.000 \
  --logical-monitor --x 0    --y 1115 --scale 1.5 --transform normal --monitor DP-1   --mode 3840x2160@59.997 \
  --logical-monitor --primary --x 2560 --y 1080 --scale 1.0 --transform normal --monitor DP-2 --mode 2560x1440@143.998+vrr \
  --logical-monitor --x 5120 --y 1080 --scale 1.0 --transform normal --monitor DP-3   --mode 2560x1440@59.951
