{{- /* chezmoi:modify-template */ -}}
{{- /*
  ~/.zshrc is rebuilt on every apply, like ~/.bashrc:
    1. the managed part below (from the repo),
    2. a marker line,
    3. marked blocks ("# >>> name ... >>>" ... "# <<< name <<<") found above the
       marker in the existing file, e.g. morbit-setup's,
    4. everything that was below the marker in the existing file, verbatim.
*/ -}}
{{- $m := includeTemplate "machine.json" . | fromJson -}}
{{- $marker := "# ---- Kept on chezmoi apply: anything below this line (other tools' additions) ----" -}}
{{- $head := .chezmoi.stdin -}}
{{- $tail := "" -}}
{{- if contains (printf "\n%s\n" $marker) (printf "\n%s" .chezmoi.stdin) -}}
{{-   $parts := splitn (printf "%s\n" $marker) 2 (printf "\n%s" .chezmoi.stdin) -}}
{{-   $head = $parts._0 -}}
{{-   $tail = $parts._1 -}}
{{- end -}}
#
# ~/.zshrc — managed by chezmoi (github.com/eijnar/dotfiles).
# Edit this part with `chezmoi edit ~/.zshrc` (direct edits above the "Kept"
# line are overwritten on the next apply). Machine-local settings belong in
# ~/.config/shell/local.d/*.sh. zsh is normally started by ~/.bashrc: the
# login shell stays bash (see there). Never `chezmoi add` this file.
#

[[ -r ~/.config/shell/env.sh ]] && source ~/.config/shell/env.sh
[[ -r ~/.config/shell/aliases.sh ]] && source ~/.config/shell/aliases.sh

# History
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt extended_history hist_ignore_dups hist_ignore_space hist_reduce_blanks share_history
setopt interactive_comments

# Keys: emacs mode, plus what bash got from /etc/inputrc
bindkey -e
bindkey '^[[H' beginning-of-line        # Home
bindkey '^[OH' beginning-of-line
bindkey '^[[1~' beginning-of-line
bindkey '^[[F' end-of-line              # End
bindkey '^[OF' end-of-line
bindkey '^[[4~' end-of-line
bindkey '^[[3~' delete-char             # Delete
bindkey '^[[2~' quoted-insert           # Insert
bindkey '^[[1;5C' forward-word          # Ctrl+Right
bindkey '^[[1;5D' backward-word         # Ctrl+Left
bindkey '^[^[[C' forward-word           # Alt+Right
bindkey '^[^[[D' backward-word          # Alt+Left
bindkey '^[[5~' beginning-of-history    # PageUp
bindkey '^[[6~' end-of-history          # PageDown

# Terminal / tmux pane title: user@host:dir (bash got this from /etc/bash.bashrc)
case $TERM in
  alacritty*|foot*|kitty*|tmux*|xterm*|rxvt*|konsole*|gnome*)
    autoload -Uz add-zsh-hook
    __dotfiles_title() { print -Pn '\e]0;%n@%m:%~\a' }
    add-zsh-hook precmd __dotfiles_title
    ;;
esac

# Completion (the zsh-completions package adds to the default fpath)
autoload -Uz compinit
[[ -d ${XDG_CACHE_HOME:-$HOME/.cache}/zsh ]] || mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-$ZSH_VERSION"
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# fzf: Ctrl-R history search, Ctrl-T file picker, Alt-C cd
(( $+commands[fzf] )) && source <(fzf --zsh)

# Prompt
(( $+commands[starship] )) && eval "$(starship init zsh)"

# Machine-local settings (not in the repo)
for __f in ~/.config/shell/local.d/*.sh(N); do source "$__f"; done
unset __f

# VS Code's integrated terminal: its shell integration (bash would have had it)
[[ $TERM_PROGRAM == vscode ]] && (( $+commands[code] )) &&
  source "$(code --locate-shell-integration-path zsh)"

# Plugins from Arch packages; syntax highlighting has to be sourced last
[[ -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]] &&
  source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -r /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] &&
  source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

(( $+commands[fastfetch] )) && fastfetch

# Tell me when the dotfiles have updates waiting or changes to push
[[ -r ~/.config/shell/dotfiles-check.sh ]] && source ~/.config/shell/dotfiles-check.sh

{{ $marker }}
{{- range $block := regexFindAll "(?ms)^# >>> [^\n]*>>>[ \t\r]*\n.*?^# <<< [^\n]*<<<[ \t\r]*(?:\n|\\z)" $head -1 }}

{{ trimSuffix "\n" $block }}
{{- end }}
{{ $tail -}}
