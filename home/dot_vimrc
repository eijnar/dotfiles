" ~/.vimrc — managed by chezmoi (github.com/eijnar/dotfiles)

" Keep vim's defaults (mouse, scrolloff, last-position jump, ...), which a
" ~/.vimrc otherwise switches off; the settings below go on top.
unlet! skip_defaults_vim
source $VIMRUNTIME/defaults.vim

set hidden
set nowrap
set tabstop=4
set shiftwidth=4
set softtabstop=4
set showmatch
set ignorecase
set smartcase
set smarttab
set incsearch

set history=1000
set undolevels=1000

syntax on
filetype plugin indent on

" Colours: vim's defaults. Built-in schemes to try with :colorscheme are
" habamax, sorbet, retrobox, wildcharm and unokai.
