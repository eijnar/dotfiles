{{- /* Files only some machines get; flags live in .chezmoidata/machines.yaml. */ -}}
{{- $m := includeTemplate "machine.json" . | fromJson -}}

{{- if not $m.focusrite }}
.config/wireplumber/wireplumber.conf.d/60-scarlett-4i4-split.conf
.local/share
.config/wireplumber/wireplumber.conf.d/54-scarlett-pro-audio-only.conf
.config/alsa-card-profile
{{- end }}

{{- if not $m.disable_audio_devices }}
.config/wireplumber/wireplumber.conf.d/52-disable-devices.conf
{{- end }}

{{- if and (not $m.focusrite) (not $m.disable_audio_devices) }}
.config/wireplumber
{{- end }}

{{- if not $m.monitors }}
.local/bin/monitor_on
.local/bin/monitor_off
.local/bin/monitor-toggle
{{- end }}

{{- if not $m.whitelight }}
.local/bin/whitelight
{{- end }}

{{- if not $m.desktop }}
.config/alacritty
{{- end }}

{{- /* Work machines never get anything under ~/.ssh from this repo. */}}
{{- if not $m.github_yubikey }}
.ssh
.local/bin/setup-yubikey
{{- end }}
