# ~/.tmux.conf — managed by chezmoi (github.com/eijnar/dotfiles)

# Refresh these from the attaching client, so a forwarded ssh-agent keeps
# working in new panes after re-attaching over SSH.
set -g update-environment "DISPLAY SSH_ASKPASS SSH_AGENT_PID SSH_CONNECTION SSH_CLIENT WINDOWID XAUTHORITY SSH_AUTH_SOCK"

# Plugins: chezmoi clones them into ~/.tmux/plugins (.chezmoiexternal.toml.tmpl,
# list in .chezmoidata/tools.yaml); tpm loads them.
{{- range .tmux.plugins }}
set -g @plugin '{{ . }}'
{{- end }}

# Fix wonky ESC behaviour
set -s escape-time 0

# Fix home/end keys not working due to xterm-256color term
bind -n End send-key C-e
bind -n Home send-key C-a

# Set Ctrl+b to be prefix
bind C-b send-prefix
set -g prefix C-b

unbind [
bind Escape copy-mode

bind r source-file ~/.tmux.conf

# Bind Shift+Alt+Arrow-keys to resize panes
bind -n M-S-Down resize-pane -D 1
bind -n M-S-Up resize-pane -U 1
bind -n M-S-Right resize-pane -R 3
bind -n M-S-Left resize-pane -L 3

# Bind Shift+left/right keys to move through windows
bind -n S-Right next-window
bind -n S-Left previous-window

# Bind Alt+Arrow-keys to switch panes
bind -n M-Left select-pane -L
bind -n M-Right select-pane -R
bind -n M-Up select-pane -U
bind -n M-Down select-pane -D

# Bind Shift+Up/Down to move panes
bind -n S-Up swap-pane -s +1
bind -n S-Down swap-pane -s -1

# Mouse: only scrolling (wheel), clicking a pane to focus it and dragging pane
# borders to resize. Everything else tmux would do with the mouse is unbound
# (menus, status-bar clicks, middle-click paste, tmux's own text selection).
# Select and paste text with the terminal as usual, holding Shift.
set -g mouse on
unbind -q -T root C-MouseDown1Status
unbind -q -T root C-MouseDrag1Empty
unbind -q -T root C-MouseDrag1Pane
unbind -q -T root DoubleClick1Pane
unbind -q -T root TripleClick1Pane
unbind -q -T root M-MouseDown3Empty
unbind -q -T root M-MouseDown3Pane
unbind -q -T root M-MouseDown3Status
unbind -q -T root M-MouseDown3StatusLeft
unbind -q -T root M-MouseDrag1Border
unbind -q -T root M-MouseDrag1Pane
unbind -q -T root MouseDown1Control7
unbind -q -T root MouseDown1Control8
unbind -q -T root MouseDown1Control9
unbind -q -T root MouseDown1ScrollbarDown
unbind -q -T root MouseDown1ScrollbarUp
unbind -q -T root MouseDrag1ScrollbarSlider
unbind -q -T root MouseDown1Status
unbind -q -T root MouseDown2Pane
unbind -q -T root MouseDown3Empty
unbind -q -T root MouseDown3Pane
unbind -q -T root MouseDown3Status
unbind -q -T root MouseDown3StatusLeft
unbind -q -T root MouseDrag1Pane
unbind -q -T root WheelUpStatus
unbind -q -T root WheelDownStatus
# Scrolling enters copy mode: keep the wheel and click-to-focus there, but no
# tmux text selection either.
unbind -q -T copy-mode MouseDrag1Pane
unbind -q -T copy-mode MouseDragEnd1Pane
unbind -q -T copy-mode DoubleClick1Pane
unbind -q -T copy-mode TripleClick1Pane
unbind -q -T copy-mode-vi MouseDrag1Pane
unbind -q -T copy-mode-vi MouseDragEnd1Pane
unbind -q -T copy-mode-vi DoubleClick1Pane
unbind -q -T copy-mode-vi TripleClick1Pane

# Status bar
set-option -g status-position bottom

# Colors and terminal settings
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",*256col*:smcup@:rmcup@:Tc"
# Alacritty reports TERM=alacritty, which the override above misses: tell tmux
# it does 24-bit colour, so colours inside tmux are not cut down to 256.
set -as terminal-features ",alacritty*:RGB"


######################
### DESIGN CHANGES ###
######################

# tmux-powerline sets status-left/status-right itself when tpm loads it.
set-option -g status on
set-option -g status-interval 2
set-option -g status-justify "centre"
set-option -g status-left-length 60
set-option -g status-right-length 90

# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run -b '~/.tmux/plugins/tpm/tpm'
